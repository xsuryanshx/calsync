# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js session signing (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Refresh-token encryption key (generate: openssl rand -base64 32)
ENCRYPTION_KEY=

# Vercel Postgres / Neon connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/calsync

# Upstash Redis (optional locally, recommended in Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
