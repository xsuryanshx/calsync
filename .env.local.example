# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js session signing (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Refresh-token encryption key (generate: openssl rand -base64 32)
ENCRYPTION_KEY=

# Database
DATABASE_URL=file:./calsync.db
